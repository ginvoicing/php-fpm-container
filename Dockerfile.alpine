# Official PHP 8.5 image based on Alpine
FROM php:8.5-fpm-alpine3.24

LABEL maintainer="Tarun Jangra <tarun.jangra@hotmail.com>"

# Runtime libraries needed by the extensions below, kept in the final image
RUN apk add --no-cache \
        curl \
        freetype \
        gmp \
        icu-libs \
        libjpeg-turbo \
        libpng \
        libxml2 \
        libzip \
        oniguruma \
        unzip \
        zip \
    # Build-time headers, removed again once the extensions are compiled
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        curl-dev \
        freetype-dev \
        gmp-dev \
        icu-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        libxml2-dev \
        libzip-dev \
        oniguruma-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        bcmath \
        curl \
        fileinfo \
        gd \
        gmp \
        intl \
        mysqli \
        pdo_mysql \
        zip \
    && apk del .build-deps
